{
  "expo": {
    "name": "Academia",
    "slug": "academia-fichas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0f14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0d0f14",
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O app usa a câmera para você tirar fotos de registro dos seus treinos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "O app salva as fotos de registro dos treinos na sua galeria.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ]
  }
}
